# Copy to backend/.env and fill in. Never commit .env.

# Database (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_carpark
DB_USER=root
DB_PASSWORD=

# OneMap: email + password (token renewed automatically) or a ready-made token
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_API_TOKEN=

# LTA DataMall (EV charging, not wired up yet)
LTA_API_KEY=

# Optional: data.gov.sg API key (higher rate limit for the collector / backfill)
DATA_GOV_SG_API_KEY=

# Run the collector inside the API process? Only with ONE uvicorn worker.
# Usually leave false and run:  python -m app.collectors.run_collector
COLLECTOR_ENABLED=false
