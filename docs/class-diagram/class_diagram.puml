@startuml class_diagram
' Best Carpark App: design class diagram, matching the code on main
' (backend/app/ and frontend/js/views/).
' Backend members use the Python names and types from the code; frontend boundary
' classes use the JavaScript method names. "[0..1]" = may be None/null, "[*]" = list.
' Render: https://www.plantuml.com/plantuml or the VS Code "PlantUML" extension.

skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle

' ======================= «boundary»: frontend/js/views =======================
  class SearchEntryUI <<boundary>> {
    +btnSearchClick() : void
    +btnEditPrefsClick() : void
    +showServerError(err) : void
  }
  class PreferenceUI <<boundary>> {
    +btnSavePrefsClick() : void
    +btnCancelPrefsClick() : void
    +btnNextClick() : void
    +btnBackClick() : void
  }
  class DestinationChoiceUI <<boundary>> {
    +show(query, matches) : void
    +itemSelectClick(match) : void
  }
  class ResultsDashboardUI <<boundary>> {
    +btnApplySortFilterClick() : void
    +btnListToggleClick() : void
    +btnMapToggleClick() : void
    +btnEditSearchClick() : void
    +btnEditPrefsClick() : void
    +itemSelectClick(carparkId) : void
  }
  class MapViewUI <<boundary>> {
    +render(destination, results, visible) : void
    +focus(carparkId) : void
  }
  class CarparkDetailUI <<boundary>> {
    +showDetails(carparkId) : void
    +btnCloseClick() : void
  }

' ======================= «startup» / «control»: backend/app/services, collectors =======================
class AppBootstrap <<startup>> {
  -settings : Settings
  +start() : None
  +stop() : None
}

  class SearchService <<control>> {
    -search_radius_m : float = 1000
    -max_walking_routes : int = 20
    +resolve_destination(request : SearchRequest) : Location
    +search_carparks(request : SearchRequest, now : datetime [0..1]) : SearchResponse
  }
  class FeeCalculator <<control>> {
    -holidays : set<date>
    +calculate_fee(carpark_id : str, request : SearchRequest) : Decimal [0..1]
    +calculate_fee_for(carpark_id : str, lot_type : LotType, arrival : datetime, departure : datetime) : Decimal [0..1]
  }
  class AvailabilityService <<control>> {
    -STALE_AFTER : timedelta = 15 min
    +get_current_availability(carpark_id : str, lot_type : LotType) : Availability [0..1]
    +get_current_availability_many(carpark_ids : str [*], lot_type : LotType, now : datetime [0..1]) : dict<str, Availability>
  }
  class BusynessEstimator <<control>> {
    -MIN_SAMPLES : int = 3
    +{static} estimate_busyness(records : HistoricalAvailability [*], arrival : datetime) : ExpectedBusyness [0..1]
    +get_expected_busyness(carpark_id : str, lot_type : LotType, arrival : datetime) : ExpectedBusyness [0..1]
  }
  class RankingEngine <<control>> {
    -WEIGHT_DECAY : float = 0.6
    +rank_carparks(results : SearchResult [*], preference : SearchPreference) : RankedResultList
  }
  class EVChargingService <<control>> {
    -match_radius_m : float = 75
    +loaded : bool {readOnly}
    +refresh() : bool
    +match_flags(carparks : CarparkInfo [*]) : dict<str, bool>
    +get_charging_info(carpark : CarparkOut, now : datetime [0..1]) : EVCharging
  }
  class WalkingService <<control>> {
    -cache_ttl_seconds : int = 3600
    +get_route(from_loc : Location, to_loc : Location) : WalkingRoute [0..1]
    +get_routes(destination : Location, carparks : dict<str, Location>) : dict<str, WalkingRoute [0..1]>
  }
  class HistoricalAvailabilityCollector <<control>> {
    +interval_min : int = 10
    +poll_once(at : datetime [0..1]) : int
    +backfill(days : int = 28, step_min : int = 15, delay_s : float = 2.0) : dict<str, int>
    +refresh_carparks() : None
    +poll_ura() : int
    +refresh_ev() : int
  }
  class UraSync <<control>> {
    -capacity : dict<(str, LotType), int>
    +load() : dict<str, int>
    +poll_once() : int
  }

class PublicHolidays <<utility>> {
  +{static} SG_PUBLIC_HOLIDAYS_2026 : frozenset<date>
  +{static} sg_public_holidays() : frozenset<date>
}
note bottom of PublicHolidays : utils/public_holidays.py (module functions).\nPassed to FeeCalculator so public holidays\nare priced as SUNDAY_PH.

' ======================= «persistent store»: backend/app/repositories =======================
  class CarparkRepository <<persistent store>> {
    +get_nearby_carparks(location : Location, radius_m : float = 1000, carpark_types : str [*] [0..1], ev_required : bool = False, include_season_only : bool = False) : CarparkInfo [*]
    +get_carpark_by_id(carpark_id : str) : CarparkInfo [0..1]
    +get_rate_rules(carpark_id : str, lot_type : LotType) : RateRuleInfo [*]
    +get_lot_types(carpark_ids : str [*]) : dict<str, set<LotType>>
  }
  class HistoricalAvailabilityRepository <<persistent store>> {
    +save_availability_records(readings : AvailabilityReading [*]) : int
    +get_historical_records(carpark_id : str, lot_type : LotType, arrival_time : datetime, window_minutes : int = 15, lookback_days : int = 56) : HistoricalAvailability [*]
    +get_latest_availability(carpark_ids : str [*], lot_type : LotType) : dict<str, AvailabilityReading>
  }

' ======================= «interface» and adapters: backend/app/clients =======================
  interface MapService <<interface>> {
    +geocode(query : str) : Location
    +search_locations(query : str, limit : int = 5) : PlaceMatch [*]
    +walking_route(start : Location, end : Location) : WalkingRoute
  }
  interface CarparkDataSource <<interface>> {
    +fetch_carparks() : (CarparkInfo, str) [*]
    +fetch_availability(resolve_ids, at : datetime [0..1]) : AvailabilityReading [*]
  }
  interface EVChargingSource <<interface>> {
    +fetch_charging_points() : EVStation [*]
  }
  class OneMapAdapter
  class HdbAdapter
  class LtaDataMallAdapter
  class UraClient {
    +configured : bool {readOnly}
    +token(force : bool = False) : str
    +fetch_details() : dict [*]
    +fetch_availability() : dict [*]
  }

' ======================= entities, data types, containers =======================
class SearchRequest {
  destination_address : str
  destination_location : Location [0..1]
  arrival_time : datetime
  departure_time : datetime [0..1]
  parking_duration_minutes : int [0..1]
  +get_parking_duration() : timedelta
}
class SearchPreference {
  priority_ranking : RankingFactor [*]
  lot_type : LotType
  vehicle_height_m : float [0..1]
  carpark_types : str [*]
  ev_required : bool
}
class SearchResponse {
  destination_address : str
  message : str [0..1]
}
class RankedResultList <<container>> {
  +sorted_with_tie_break() : SearchResult [*]
}
class SearchResult {
  rank : int
  straight_line_m : float [0..1]
  walking_distance_m : int [0..1]
  walking_time_min : float [0..1]
  walking_time_estimated : bool
  estimated_fee_sgd : Decimal [0..1]
  height_unknown : bool
  composite_score : float
}
class CarparkInfo <<persistent>> {
  carpark_id : str
  name : str
  address : str [0..1]
  latitude : float
  longitude : float
  carpark_type : str [0..1]
  parking_system : str [0..1]
  operator : str [0..1]
  gantry_height_m : float [0..1]
  free_parking : str [0..1]
  night_parking : bool [0..1]
  has_ev_charging : bool [0..1]
  short_term_parking : str [0..1]
}
class CarparkOut {
  carpark_id : str
  name : str
  carpark_type : str [0..1]
  gantry_height_m : float [0..1]
  has_ev_charging : bool [0..1]
  +{static} from_info(c : CarparkInfo) : CarparkOut
  +fits_vehicle_height(height_m : float [0..1]) : bool [0..1]
}
class Location <<data type>> {
  latitude : float
  longitude : float
}
class PlaceMatch <<data type>> {
  name : str
  address : str [0..1]
}
class WalkingRoute <<data type>> {
  distance_m : int
  duration_s : int
}
class RateScheme <<persistent>> {
  rate_scheme_id : int
  name : str
}
class RateRuleInfo <<persistent>> {
  lot_type : LotType
  day_type : DayType
  start_time : time
  end_time : time
  charge_mode : ChargeMode
  rate_sgd : Decimal
  interval_min : int [0..1]
  per_minute : bool
  first_interval_min : int [0..1]
  first_rate_sgd : Decimal [0..1]
  cap_sgd : Decimal [0..1]
  cap_scope : CapScope [0..1]
  grace_min : int [0..1]
  priority : int
}
class UraRate <<data type>> {
  lot_type : LotType
  day_type : DayType
  start : time
  end : time
  rate : Decimal
  interval_min : int
}
class AvailabilityReading <<persistent>> {
  carpark_id : str
  lot_type : LotType
  available_lots : int
  total_lots : int [0..1]
  observed_at : datetime
  collected_at : datetime
}
class HistoricalAvailability <<persistent>> {
  carpark_id : str
  lot_type : LotType
  available_lots : int
  total_lots : int [0..1]
  timestamp : datetime
}
class Availability {
  available_lots : int
  total_lots : int [0..1]
  occupancy_pct : int [0..1]
  last_updated : datetime
  is_stale : bool
}
class ExpectedBusyness {
  occupancy_pct : int
  level : BusynessLevel
  sample_count : int
}
class EVCharging {
  supported : bool [0..1]
  available_chargers : int [0..1]
}
class EVStation <<data type>> {
  latitude : float
  longitude : float
  total_points : int
  available_points : int [0..1]
  plug_types : str [*]
}

enum RankingFactor <<enumeration>> {
  PRICE
  WALKING_TIME
  AVAILABILITY
}
enum LotType <<enumeration>> {
  CAR
  MOTORCYCLE
  HEAVY_VEHICLE
}
enum DayType <<enumeration>> {
  WEEKDAY
  SATURDAY
  SUNDAY_PH
  ALL
}
enum ChargeMode <<enumeration>> {
  PER_INTERVAL
  PER_ENTRY
  FREE
}
enum CapScope <<enumeration>> {
  WINDOW
  ENTRY
  DAY
}
enum BusynessLevel <<enumeration>> {
  LOW
  MODERATE
  HIGH
}

' ======================= boundary navigation (dialog map) =======================
SearchEntryUI ..> PreferenceUI
SearchEntryUI ..> DestinationChoiceUI
SearchEntryUI ..> ResultsDashboardUI
ResultsDashboardUI ..> PreferenceUI
ResultsDashboardUI *-- MapViewUI
ResultsDashboardUI ..> CarparkDetailUI
PreferenceUI --> SearchPreference : edits
SearchEntryUI ..> SearchService : submits SearchRequest\n(POST /api/v1/search)
CarparkDetailUI ..> CarparkRepository : GET /api/v1/carparks/{id}

' ======================= startup =======================
AppBootstrap ..> HistoricalAvailabilityCollector : schedules
AppBootstrap ..> SearchService : creates

' ======================= control dependencies =======================
SearchService --> MapService
SearchService --> CarparkRepository
SearchService --> FeeCalculator
SearchService --> AvailabilityService
SearchService --> BusynessEstimator
SearchService --> EVChargingService
SearchService --> RankingEngine
SearchService --> WalkingService
SearchService ..> SearchResponse : creates

FeeCalculator --> CarparkRepository
FeeCalculator ..> PublicHolidays : holidays
AvailabilityService --> HistoricalAvailabilityRepository
AvailabilityService ..> Availability : creates
BusynessEstimator --> HistoricalAvailabilityRepository
RankingEngine ..> RankedResultList : creates
WalkingService --> MapService
WalkingService ..> WalkingRoute
EVChargingService --> EVChargingSource
EVChargingService ..> EVCharging : creates

HistoricalAvailabilityCollector --> CarparkDataSource
HistoricalAvailabilityCollector --> HistoricalAvailabilityRepository
HistoricalAvailabilityCollector --> "0..1" UraSync
HistoricalAvailabilityCollector --> "0..1" EVChargingService
UraSync --> UraClient
UraSync ..> UraRate
UraSync ..> RateScheme : seeds URA rates
UraSync ..> AvailabilityReading : stores

' ======================= interface realization =======================
MapService <|.. OneMapAdapter
CarparkDataSource <|.. HdbAdapter
EVChargingSource <|.. LtaDataMallAdapter
MapService ..> PlaceMatch
EVChargingSource ..> EVStation

' ======================= entity associations =======================
SearchRequest *-- "1" SearchPreference : preference
SearchRequest --> "0..1" Location : destination_location
SearchPreference ..> RankingFactor
SearchResponse --> "1" Location : destination
SearchResponse o-- "0..*" SearchResult : results
RankedResultList o-- "0..*" SearchResult
SearchResult --> "1" CarparkOut : carpark
SearchResult *-- "0..1" Availability
SearchResult *-- "0..1" ExpectedBusyness
SearchResult *-- "1" EVCharging
CarparkOut ..> CarparkInfo : from_info
CarparkOut *-- "1" Location : location
PlaceMatch *-- "1" Location : location
CarparkInfo "0..*" --> "0..1" RateScheme
RateScheme *-- "1..*" RateRuleInfo
CarparkInfo "1" -- "0..*" HistoricalAvailability
CarparkInfo "1" -- "0..*" AvailabilityReading
ExpectedBusyness ..> HistoricalAvailability : calculated from
RateRuleInfo ..> DayType
RateRuleInfo ..> ChargeMode
RateRuleInfo ..> CapScope
ExpectedBusyness ..> BusynessLevel
SearchPreference ..> LotType
@enduml
